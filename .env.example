# Google Cloud OAuth 2.0 Client ID (Get from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs)
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Meta Facebook App ID (Get from Meta for Developers -> Apps -> App Settings -> Basic)
VITE_FACEBOOK_APP_ID=your_facebook_app_id_here

# Firebase Web App Credentials (Optional)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
